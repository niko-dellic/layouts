{
  "name": "layouts-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @niko-dellic/layouts-core && npm run build -w @niko-dellic/layouts && npm run build -w @niko-dellic/layouts-react",
    "typecheck": "tsc -p tsconfig.demo.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:packed": "node scripts/test-packed.mjs",
    "dev": "vite --host localhost --port 5186",
    "build:demos": "vite build",
    "pack:all": "node scripts/pack.mjs",
    "check": "node scripts/check-runtime.mjs && npm run format:check && npm run build && npm run typecheck && npm test && npm run test:browser && npm run build:demos && npm run test:packed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
